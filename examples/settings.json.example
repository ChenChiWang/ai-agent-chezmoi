{
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash(sh ~/.config/ai-agent/bin/sync.sh status:*)",
      "Bash(sh ~/.config/ai-agent/bin/sync.sh check:*)",
      "Bash(sh ~/.config/ai-agent/bin/sync.sh doctor:*)",
      "Bash(sh ~/.config/ai-agent/bin/sync.sh plan:*)"
    ]
  }
}
